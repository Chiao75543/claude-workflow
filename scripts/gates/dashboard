# 型別宣告。要吃得下常見寫法,否則最該檢查的東西反而隱形:
#   @MainActor final class XViewModel / actor XService / data class / sealed class / object
# 以及 Compose 的 @Composable fun XScreen(。
ATTRS = r"(?:@[\w.]+(?:\([^)]*\))?\s+)*"
MODS = r"(?:(?:public|private|fileprivate|internal|open|final|abstract|sealed|data|value|export|default)\s+)*"
# G7 找的是「可被建構的產品型別」；enum case 用 `.case`，
# protocol/interface 由具體型別實作，都不應硬找 `TypeName(`。
DECL = re.compile(rf"^\s*{ATTRS}{MODS}(?:struct|class|actor|object|record)\s+(\w+)", re.M)
ENUM_DECL = re.compile(
    rf"^\s*{ATTRS}{MODS}enum\s+(\w+)(?:<[^{{}}\n]+>)?\s*(?::\s*([^{{\n]+))?\s*\{{", re.M
)
RAW_ENUM_TYPES = {
    "String", "Character", "Int", "Int8", "Int16", "Int32", "Int64",
    "UInt", "UInt8", "UInt16", "UInt32", "UInt64", "Float", "Double",
}
# 大寫開頭的 fun 是 Compose 畫面的慣例
FUNC_DECL = re.compile(rf"^\s*{ATTRS}{MODS}fun\s+([A-Z]\w*)\s*\(", re.M)
# file-local 的型別本來就不該對外可達,不是 G8 要問的問題
PRIVATE = re.compile(rf"^\s*{ATTRS}(?:private|fileprivate)\s", re.M)


def constructible_enum_names(text: str) -> list[str]:
    """Swift raw-value enum 或本體有頂層 init 時，仍能以 TypeName(...) 建構。"""
    names = []
    for match in ENUM_DECL.finditer(text):
        inherited = (match.group(2) or "").split(",", 1)[0].strip()
        raw_type = inherited.rsplit(".", 1)[-1]
        depth = 0
        has_initializer = False
        body_start = match.end()
        for line in text[body_start:].splitlines():
            if depth == 0 and re.match(
                rf"^\s*{ATTRS}{MODS}init[?!]?(?:\s*<[^\n{{}}]+>)?\s*\(", line
            ):
                has_initializer = True
                break
            depth += line.count("{") - line.count("}")
            if depth < 0:
                break
        if raw_type in RAW_ENUM_TYPES or has_initializer:
            names.append(match.group(1))
    return names


# 這幾個標籤是「要人做決定」,其他的只是讓人知道。自動推只被前者擋。
DECISION_TAGS = {"需要你決定", "要重新批准", "要人工驗", "無法驗證", "無外部錨定"}


def git(root: pathlib.Path, *args: str) -> str:
    try:
        return subprocess.run(["git", *args], cwd=root, capture_output=True,
                              text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def git_required(root: pathlib.Path, label: str, *args: str) -> str:
    """安全關卡使用的 Git 讀取；錯誤不能被當成空集合。"""
    try:
        result = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True, errors="replace")
    except (OSError, subprocess.CalledProcessError) as exc:
        detail = getattr(exc, "stderr", None) or str(exc)
        raise RuntimeError(f"{label} Git 執行失敗: {detail}") from exc
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"{label} Git 執行失敗: {detail}")
    return result.stdout


def approval_anchor_snapshot(root: pathlib.Path, approved: pathlib.Path) -> tuple[str, tuple]:
    """回傳狀態與不可變 mode/blob token，供裁決前後重驗。"""
    root_abs = root.absolute()
    approved_abs = approved.absolute()
    rel_path = approved_abs.relative_to(root_abs)
    cursor = root_abs
    for part in rel_path.parts:
        cursor = cursor / part
        if cursor.is_symlink():
            raise RuntimeError(f"approval path 不得是 symlink: {rel_path}")
    if not approved_abs.exists() or not stat.S_ISREG(approved_abs.lstat().st_mode):
        raise RuntimeError(f"approval path 不是一般檔案: {rel_path}")

    rel = rel_path.as_posix()
    head_line = git_required(root, "approval committed", "ls-tree", "HEAD", "--", rel).strip()
    index_lines = git_required(root, "approval index", "ls-files", "--stage", "--", rel).splitlines()
    head_entry = head_line.split("\t", 1)[0].split() if head_line else []
    index_entries = [line.split("\t", 1)[0].split() for line in index_lines if line]
    if len(index_entries) > 1 or (index_entries and index_entries[0][2] != "0"):
        raise RuntimeError(f"approval index 存在衝突 stage: {rel}")
    head_mode = head_entry[0] if len(head_entry) >= 3 else None
    head_blob = head_entry[2] if len(head_entry) >= 3 else None
    index_mode = index_entries[0][0] if index_entries else None
    index_blob = index_entries[0][1] if index_entries else None
    if head_mode not in (None, "100644") or index_mode not in (None, "100644"):
        raise RuntimeError(f"approval snapshot 必須是一般非執行檔: {rel}")
    worktree_blob = git_required(
        root, "approval worktree", "hash-object", f"--path={rel}", "--", rel
    ).strip()
    token = (rel, head_mode, head_blob, index_mode, index_blob, worktree_blob)
    if head_blob and index_blob == head_blob and worktree_blob == index_blob:
        return "committed", token
    if index_blob and index_blob != head_blob and worktree_blob == index_blob:
        return "pending_commit", token
    return "unstaged", token


def approval_anchor_state(root: pathlib.Path, approved: pathlib.Path) -> str:
    """committed / pending_commit / unstaged；pending 絕不等於 owner approval。"""
    return approval_anchor_snapshot(root, approved)[0]


def in_reach_scope(root: pathlib.Path, rel: str, globs: list[str]) -> bool:
    return any(pathlib.Path(root, rel).match(g) or rel.startswith(g.split("*")[0]) for g in globs)


def check_reachability(root: pathlib.Path, base: str, config: dict) -> list[dict]:
    """G7:新增的型別有沒有人建構它。缺席類問題唯一的機械防線。"""
    merge_base = git_required(root, "reachability base", "merge-base", base, "HEAD").strip()
    committed = {
        p for p in git_required(
            root, "committed reachability diff", "diff", "--name-only", "--diff-filter=A",
            f"{merge_base}...HEAD",
        ).splitlines() if p
    }
    # index 要和 integration merge-base 比，不是和 HEAD 比；這樣同時涵蓋分支已 commit
    # 與目前 staged 的完整候選樹。set 聯集會去掉兩個視角都列到的同一路徑。
    staged = {
        p for p in git_required(
            root, "staged reachability diff", "diff", "--cached", "--name-only", "--diff-filter=A",
            merge_base,
        ).splitlines() if p
    }
    added = sorted(committed | staged)
    globs = config["reachability"]["globs"] or []
    in_scope = {p for p in added if in_reach_scope(root, p, globs)}

    # 自己用 Python 搜,不外包給 git grep ——
    # git grep -E 是 POSIX ERE,不支援 \b 與 \s,pattern 會靜默匹配不到而全部誤報。
    #
    # **建構點只能在產品程式碼裡。** 測試檔、markdown、註解都不算 ——
    # 每個型別都有規格測試會 Name(),把測試算進來的話 G7 幾乎必然通過,
    # 那它就完全失去存在意義(對抗審查實證)。
    tracked = [t for t in git_required(root, "reachability files", "ls-files").splitlines() if t]
    production = {t for t in tracked if in_reach_scope(root, t, globs)}
    contents: dict[str, str] = {}
    for rel in production:
        contents[rel] = git_required(root, f"reachability blob {rel}", "show", f":{rel}")

    results = []
    for rel in sorted(in_scope):
        text = contents.get(rel)
        if text is None:
            continue
        # 檔案裡**每一個**對外型別都要檢查,不是只看第一個 ——
        # 常見寫法是一個檔案放 View + ViewModel,只看第一個等於主型別沒被檢查。
        enum_declarations = constructible_enum_names(text)
        enum_names = set(enum_declarations)
        names = list(dict.fromkeys(
            DECL.findall(text) + enum_declarations + FUNC_DECL.findall(text)
        ))
        for name in names:
            # file-local 的型別不是 G7 要問的問題(它本來就不該對外可達)
            decl_line = next((ln for ln in text.splitlines() if re.search(rf"\b{re.escape(name)}\b", ln)
                              and (DECL.match(ln + "\n") or ENUM_DECL.match(ln + "\n")
                                   or FUNC_DECL.match(ln + "\n"))), "")
            if PRIVATE.match(decl_line + "\n"):
                continue
            # Swift raw-value enum 也常透過 `TypeName.case` / `.allCases` 接線，
            # 不只會出現 `TypeName(...)`。
            use = (re.compile(rf"\b{re.escape(name)}\s*(?:\(|\.)")
                   if name in enum_names else re.compile(rf"\b{re.escape(name)}\s*\("))
            sites = [other for other, body in contents.items()
                     if other != rel and use.search(body)]
            results.append({"file": rel, "symbol": name, "sites": sorted(sites)})
    return results


def run(cmd: list[str], cwd: pathlib.Path) -> tuple[bool, str]:
    try:
        proc = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
        return proc.returncode == 0, (proc.stdout + proc.stderr).strip()
    except FileNotFoundError:
        return False, "找不到指令"


def esc(text) -> str:
    return html.escape(str(text))


