def main(argv: list[str]) -> int:
    args = [a for a in argv if not a.startswith("-")]
    if not args:
        print(__doc__)
        return 2
    spec_path = pathlib.Path(args[0])
    root = spec_path.resolve().parents[2]
    spec = load_spec(spec_path)
    config = _config.load(root)
    pre_commit = "--pre-commit" in argv
    # base 預設跟 pipeline.yaml 的 integration_branch;寫死 main 的話,整合分支叫 develop 的專案
    # `git diff main...HEAD` 出錯回空 → G3「沒有變更的檔案」G7「0 個新型別」靜默變綠(對抗審查實證)。
    configured_base = integration_branch(root)
    requested_base = argv[argv.index("--base") + 1] if "--base" in argv else configured_base
    base = configured_base
    base_matches_config = requested_base == configured_base
    base_ok = base_matches_config and subprocess.run(
        ["git", "rev-parse", "--verify", "-q", f"{base}^{{commit}}"], cwd=root, capture_output=True
    ).returncode == 0
    base_problem = (f"--base {requested_base} 不等於設定的整合分支 {configured_base}"
                    if not base_matches_config else f"找不到整合分支 {base}")
    ev = evidence_dir(spec_path)
    here = pathlib.Path(__file__).parent

    gates, attention = [], []

    ok, _ = run([str(here / "spec-lint"), str(spec_path)], root)
    gates.append({"id": "G0", "what": "規格檢查", "ok": ok, "note": "schema/完備性/可測性"})

    frozen_ok, _ = run([str(here / "freeze-check"), str(spec_path)], root)

    # 指紋不符時,由 spec-diff 判定是「要重新批准的行為改變」還是「事實修正」。
    # 沒有批准快照就無從判斷 —— 那本身是個問題,要講出來。
    approved = ev / "spec.approved.yaml"
    approval_anchor = "missing"
    approval_anchor_token = None
    anchor_ready = False
    if approved.exists() or approved.is_symlink():
        try:
            approval_anchor, approval_anchor_token = approval_anchor_snapshot(root, approved)
        except (RuntimeError, ValueError) as exc:
            approval_anchor = "git_error"
            anchor_error = str(exc)
        anchor_ready = approval_anchor == "committed" or (
            pre_commit and approval_anchor == "pending_commit"
        )
        if approval_anchor == "pending_commit" and pre_commit:
            attention.append({
                "tag": "待提交錨定", "title": "批准快照已進 index，等待 commit 錨定",
                "body": "這只證明待提交內容與工作樹一致，不證明 owner 曾批准。"
                        "owner 的真實批准仍是 S5 前置條件；commit 後還要跑嚴格 delivery dashboard。",
            })
        elif not anchor_ready:
            title = ("批准快照必須 stage，且工作樹要與 index 一致" if pre_commit
                     else "無外部錨定：批准快照未 commit 或有修改")
            attention.append({
                "tag": "無外部錨定", "title": title,
                "body": "一般 delivery 只接受 HEAD 已包含且工作樹乾淨的 spec.approved.yaml。"
                        + (f" Git 檢查失敗：{anchor_error}" if approval_anchor == "git_error" else ""),
            })
        diff_ok, diff_out = run([str(here / "spec-diff"), str(spec_path)], root)
        factual = [ln.strip() for ln in diff_out.splitlines() if "事實修正" in ln]
        if approval_anchor == "pending_commit" and pre_commit:
            g12_note = "批准快照待 commit 錨定"
        elif approval_anchor != "committed":
            g12_note = "批准快照未錨定"
        elif frozen_ok:
            g12_note = "指紋比對"
        elif diff_ok:
            g12_note = "規格有改,但只是事實修正"
        else:
            g12_note = "規格有行為改變 → 要重新批准"
        gates.append({"id": "G1/2", "what": "規格與測試沒被偷改",
                      "ok": frozen_ok and diff_ok and anchor_ready,
                      "note": g12_note})
        if not diff_ok:
            attention.append({
                "tag": "要重新批准", "title": "規格的行為契約改過了",
                "body": "你批准的是那些具體例子,而例子(或 then / mode / 覆蓋)變了。"
                        "退回說明頁重新確認一次,再重存批准快照。",
            })
        elif factual:
            attention.append({
                "tag": "事實修正", "title": "規格改過,但不影響契約",
                "body": " ".join(factual) + " —— 不需要重新批准,但你應該知道它改過。",
            })
    else:
        gates.append({"id": "G1/2", "what": "規格與測試沒被偷改", "ok": False,
                      "note": "缺 spec.approved.yaml"})
        attention.append({
            "tag": "缺快照", "title": "沒有批准快照,無從判斷規格改動",
            "body": "S5 批准時要存下 evidence/spec.approved.yaml。"
                    "沒有它,任何後續改動都分不出是事實修正還是行為改變。",
        })

    # G2b 測試審過才凍結 —— 審過的檔案指紋要和凍結的一模一樣,否則審的是別的版本。
    review = read_json(ev / "test-review.json")
    frozen_files = {}
    for line in (ev / "tests.hash").read_text().splitlines() if (ev / "tests.hash").exists() else []:
        digest, _, rel = line.partition("  ")
        if rel:
            frozen_files[rel.strip()] = digest.strip()
    if not review:
        gates.append({"id": "G2b", "what": "測試在凍結前審過", "ok": False, "note": "缺 test-review.json"})
    elif not review.get("ok"):
        gates.append({"id": "G2b", "what": "測試在凍結前審過", "ok": False,
                      "note": f"{len(review.get('errors') or [])} 條問題"})
    elif (review.get("mechanical_only") or review.get("agent") is None) and lane(spec) != "lite":
        gates.append({"id": "G2b", "what": "測試在凍結前審過", "ok": False,
                      "note": "只跑過機械檢查,語意審查(test-reviewer)沒跑"})
    elif frozen_files and review.get("files") != frozen_files:
        gates.append({"id": "G2b", "what": "測試在凍結前審過", "ok": False, "note": "審過的和凍結的不是同一批檔"})
    else:
        semantic = not (review.get("mechanical_only") or review.get("agent") is None)
        gates.append({"id": "G2b", "what": "測試在凍結前審過", "ok": True,
                      "note": f"{review.get('tests', 0)} 條測試 · " + ("機械 + 語意" if semantic else "機械(lite:語意審查不要求)")})

    ok, out = run([str(here / "traceability"), str(spec_path)], root)
    covered = re.search(r"測試涵蓋 (\d+) 條", out)
    gates.append({"id": "G6", "what": "規格↔測試雙向", "ok": ok,
                  "note": f"{len(scenario_ids(spec))} 條 Scenario · 涵蓋 {covered.group(1) if covered else '?'}"})

    # G3 lint —— 只看變更的檔案。契約:設定的指令接受檔案路徑當結尾參數。
    changed = [c for c in (
        git(root, "diff", "--name-only", "--diff-filter=ACM", f"{base}...HEAD").split("\n")
        + git(root, "diff", "--cached", "--name-only", "--diff-filter=ACM").split("\n")
    ) if c and (root / c).is_file()]
    lint_cmd = config.get("lint")
    if not lint_cmd:
        gates.append({"id": "G3", "what": "lint(變更的檔案)", "ok": False,
                      "note": "specs/pipeline.yaml 沒設 lint"})
    elif not base_ok:
        gates.append({"id": "G3", "what": "lint(變更的檔案)", "ok": False, "note": base_problem})
    elif not changed:
        gates.append({"id": "G3", "what": "lint(變更的檔案)", "ok": True, "note": "沒有變更的檔案"})
    else:
        ok, out = run(lint_cmd.split() + changed, root)
        gates.append({"id": "G3", "what": "lint(變更的檔案)", "ok": ok,
                      "note": f"{len(changed)} 個檔案" if ok else out.strip().splitlines()[-1][:60]})

    # G4 測試 —— 沒設定指令就是失敗。證據表不能宣稱「綠」而沒有人跑過。
    test_cmd = config.get("test")
    if not test_cmd:
        gates.append({"id": "G4", "what": "測試實作後是綠的", "ok": False,
                      "note": "specs/pipeline.yaml 沒設 test"})
        attention.append({
            "tag": "無法驗證", "title": "沒有人確認測試現在是綠的",
            "body": "RED 證據只證明測試在實作前是紅的,不證明實作後是綠的。"
                    "沒設 test 指令的話,GREEN 仍然只是「AI 說 OK」—— 那正是這條線要消滅的東西。",
        })
    else:
        ok, out = run(test_cmd.split(), root)
        gates.append({"id": "G4", "what": "測試實作後是綠的", "ok": ok,
                      "note": "全綠" if ok else out.strip().splitlines()[-1][:60]})

    red = read_json(ev / "red.json")
    if red:
        counts = red.get("counts", {})
        blocking = {k: v for k, v in counts.items() if k in {"error", "compile", "hang", "passed"}}
        recon_ok = all(r.get("reconciled") for r in red.get("reconciliation", []))
        gates.append({"id": "G5", "what": "每條測試都曾真的紅過", "ok": not blocking and recon_ok,
                      "note": " · ".join(f"{k} {v}" for k, v in counts.items())})
        exempted = [t for t in red.get("tests", []) if t.get("failure_class") == "exempt"]
        if exempted:
            reasons = red.get("exemptions", {})
            attention.append({
                "tag": "書面豁免", "title": f"{len(exempted)} 條測試靠豁免通過 G5",
                "body": "這些測試在實作前就是綠的,靠規格裡寫的理由放行:"
                        + "；".join(f"{k} —— {v}" for k, v in list(reasons.items())[:3])
                        + "。豁免只在該測試完全沒建構 repository stub 時成立,請確認理由站得住。",
            })
    else:
        gates.append({"id": "G5", "what": "每條測試都曾真的紅過", "ok": False, "note": "缺 red.json"})

    if not config["reachability"]["globs"]:
        reach, unreachable = [], []
        gates.append({"id": "G7", "what": "新增的東西到得了", "ok": False,
                      "note": "specs/pipeline.yaml 沒設 reachability.globs"})
    elif not base_ok:
        reach, unreachable = [], []
        gates.append({"id": "G7", "what": "新增的東西到得了", "ok": False, "note": base_problem})
    else:
        try:
            reach = check_reachability(root, base, config)
            unreachable = [r for r in reach if not r["sites"]]
            gates.append({"id": "G7", "what": "新增的東西到得了", "ok": not unreachable,
                          "note": f"{len(reach)} 個新型別 · {len(unreachable)} 個沒有建構點"})
        except RuntimeError as exc:
            reach, unreachable = [], []
            gates.append({"id": "G7", "what": "新增的東西到得了", "ok": False,
                          "note": str(exc)[:120]})
    for item in unreachable:
        attention.append({
            "tag": "到不了", "title": f"{item['symbol']} 沒有任何建構點",
            "body": f"{item['file']} 定義了它,但整個 repo 沒有別的地方呼叫 {item['symbol']}(。"
                    "合併之後使用者體感會是零 —— 這類問題寫不出失敗測試,所以只有這道關擋得住。",
        })

    # smoke —— 功能不對其他免談。證據要新鮮:工作樹指紋對不上就是過期。
    current_tree = tree_fingerprint(root)
    candidate_index_tree = None
    if pre_commit:
        try:
            candidate_index_tree = index_fingerprint(root)
            index_matches_worktree = candidate_index_tree == current_tree
            index_note = "index 與工作樹一致" if index_matches_worktree else "index 與工作樹不一致"
        except RuntimeError as exc:
            index_matches_worktree = False
            index_note = str(exc)[:120]
        gates.append({"id": "P", "what": "待提交樹已實際驗證", "ok": index_matches_worktree,
                      "note": index_note})
    # 車道豁免。豁免的關留在證據表上(note 寫明),不是消失 —— 「沒檢查」和「檢查過」要分得出來。
    # 只有 WAIVABLE_GATES(腳本關)能被豁免:smoke 與付費審查就算被塞進 LITE_WAIVED_GATES 也不會放行。
    spec_lane = lane(spec)

    def apply_lane_waivers() -> None:
        if spec_lane != "lite":
            return
        for g in gates:
            if g["id"] in LITE_WAIVED_GATES and g["id"] in WAIVABLE_GATES and not g["ok"] and not g.get("waived"):
                g.update(ok=True, waived=True, note=f"lite 車道不要求({g['note'][:40]})")

    apply_lane_waivers()   # lite 卡不該因為 G5/G7 紅就把 G9/10 標「未跑」
    smoke = read_json(ev / "smoke.json")
    scripts_green = all(g["ok"] for g in gates)
    if not smoke:
        smoke_ok = False
        gates.append({"id": "S", "what": "smoke:真的入口跑一次", "ok": False, "note": "缺 smoke.json"})
    elif smoke.get("tree") != current_tree:
        smoke_ok = False
        gates.append({"id": "S", "what": "smoke:真的入口跑一次", "ok": False, "note": "證據過期(工作樹變了)"})
    else:
        smoke_ok = bool(smoke.get("ok"))
        gates.append({"id": "S", "what": "smoke:真的入口跑一次", "ok": smoke_ok,
                      "note": f"{smoke.get('duration_s')}s · 截圖 {len(smoke.get('screenshots') or [])} 張"
                              if smoke_ok else ("超時" if smoke.get("timed_out") else f"exit {smoke.get('exit_code')}")})

    # G9/G10 —— 付費審查。smoke 或腳本沒過就不該派;派了也只看 findings 有沒有處理完。
    findings = read_json(ev / "findings.json") or {}
    loop = read_json(ev / "loop.json") or {}
    items = findings.get("items") or []
    pending, asking = triage_findings(items)
    halted = {fid: it for fid, it in (loop.get("findings") or {}).items()
              if it.get("status") in ("parked", "flipflop")}
    # 「派過了」要有紀錄:零 finding 的乾淨審查和「根本沒派」在證據上必須分得出來
    dispatched = findings.get("dispatched") or {}
    required_reviews = ("G10",) if spec_lane == "lite" else ("G9", "G10")
    missing_dispatch = [gate for gate in required_reviews if gate not in dispatched]
    invalid_dispatch = [
        gate for gate in required_reviews
        if gate in dispatched and (
            not isinstance(dispatched[gate], dict)
            or not isinstance(dispatched[gate].get("tree"), str)
            or re.fullmatch(r"tree:(?:[0-9a-f]{40}|[0-9a-f]{64})", dispatched[gate]["tree"]) is None
        )
    ]
    stale_dispatch = [
        gate for gate in required_reviews
        if gate not in missing_dispatch and gate not in invalid_dispatch
        and dispatched[gate]["tree"] != current_tree
    ]
    if not (scripts_green and smoke_ok):
        gates.append({"id": "G9/10", "what": "獨立讀者 + 對抗審查", "ok": False,
                      "note": "未跑 —— 腳本或 smoke 沒過,不花這個錢"})
    elif missing_dispatch:
        gates.append({"id": "G9/10", "what": "獨立讀者 + 對抗審查", "ok": False,
                      "note": f"沒有派過的紀錄({', '.join(missing_dispatch)})"})
    elif invalid_dispatch:
        gates.append({"id": "G9/10", "what": "獨立讀者 + 對抗審查", "ok": False,
                      "note": f"dispatch tree 無效({', '.join(invalid_dispatch)})，必須重新審查"})
    elif stale_dispatch:
        gates.append({"id": "G9/10", "what": "獨立讀者 + 對抗審查", "ok": False,
                      "note": f"審查過期(工作樹變了: {', '.join(stale_dispatch)})"})
    else:
        s = findings.get("summary") or {}
        gates.append({"id": "G9/10", "what": "獨立讀者 + 對抗審查", "ok": not pending and not halted,
                      "note": f"提出 {s.get('proposed', 0)} → 作廢 {s.get('void', 0)} → 證實 {s.get('confirmed', 0)}"
                              + (f" · {len(pending)} 條沒處理完" if pending else "")
                              + (" · lite:只要求 G10" if spec_lane == "lite" else "")})
    for fid, it in halted.items():
        attention.append({
            "tag": "需要你決定", "title": f"{fid} {'修 2 次未果' if it['status'] == 'parked' else '解過又出現'}",
            "body": "這是決策,不是 code review:照樣出貨 / 分支停在這 / 回頭改規格。",
        })
    for i in asking:
        if spec_lane == "lite":
            # lite 車道:example 之外的 edge case 預設「先記風險、照樣往前」,不停下來等人。
            # 實測 31 條 ask_user 有三分之一最後是 accepted_risk。finding 本身不改(仍是 confirmed),
            # 人隨時可以 `findings set F-n added_example` 推翻;PR 留言會列出來。
            attention.append({
                "tag": "預設接受", "title": f"{i['id']}:{i.get('title')}",
                "body": f"{i.get('question')} 重現:{i.get('repro')}。lite 車道預設接受風險、不擋推;"
                        f"要防 → `findings set {i['id']} added_example` 走 S7 加 example。",
            })
            continue
        attention.append({
            "tag": "需要你決定", "title": f"{i['id']}:{i.get('title')}",
            "body": f"{i.get('question')} 重現:{i.get('repro')}。要防 → 加一組 example;不用 → 記成已接受風險。",
        })

    degraded = [gate for gate in ("G9", "G10")
                if isinstance(dispatched.get(gate), dict) and dispatched[gate].get("degraded")]
    if degraded:
        attention.append({"tag": "降級審查", "title": f"{'、'.join(degraded)} 不是用設定的模型審的",
                          "body": "額度用完,退到次一級模型才派得出去("
                                  + "、".join(f"{g}: {dispatched[g].get('model') or '未記錄'}" for g in degraded)
                                  + ")。不擋推 —— 但這張卡的審查強度比平常低,你該知道。"})

    manual = [sc.get("id") for req in (spec.get("requirements") or []) if isinstance(req, dict)
              for sc in (req.get("scenarios") or []) if isinstance(sc, dict) and sc.get("mode") == "6d"]
    if manual:
        attention.append({"tag": "要人工驗", "title": f"{len(manual)} 條只能人工驗證",
                          "body": "、".join(manual) + " —— 這些沒有自動化證據,你得自己跑一次。"})

    # 畫面證據只認這一輪 smoke 記下的截圖;目錄裡的舊圖不算(smoke 開跑會清,但這裡不信目錄)
    shots = sorted(smoke.get("screenshots") or []) if smoke and smoke_ok else []
    if not shots:
        attention.append({"tag": "無畫面證據", "title": "沒有任何截圖",
                          "body": "如果這次有畫面變更,單元測試驗不到它的呈現。"})

    # 前面逐關判斷可能要花時間；在產出裁決前再確認一次，避免工作樹在第一次取樣後改變，
    # 卻讓舊 smoke 與審查指紋一起被當成目前狀態。輸出 evidence 本身不在指紋內。
    latest_tree = tree_fingerprint(root)
    if latest_tree != current_tree:
        for gate in gates:
            if gate["id"] in ("S", "G9/10") and gate["ok"]:
                gate["ok"] = False
                gate["note"] = "證據過期(dashboard 執行期間工作樹變了)"
    if pre_commit:
        try:
            latest_index_tree = index_fingerprint(root)
            candidate_stable = latest_tree == current_tree and latest_index_tree == latest_tree
        except RuntimeError:
            candidate_stable = False
        if not candidate_stable:
            for gate in gates:
                if gate["id"] == "P":
                    gate["ok"] = False
                    gate["note"] = "index 與工作樹不一致，或 dashboard 期間已變動"

    # approval 在 evidence 目錄，刻意不進入上面兩種全樹指紋。因此必須獨立重驗，
    # 防 lint/test 或並行程序在初次驗證後替換、重新 stage 快照。
    if approval_anchor_token is not None:
        try:
            latest_anchor, latest_anchor_token = approval_anchor_snapshot(root, approved)
            anchor_still_ready = latest_anchor == "committed" or (
                pre_commit and latest_anchor == "pending_commit"
            )
            anchor_stable = latest_anchor_token == approval_anchor_token and anchor_still_ready
            approval_anchor = latest_anchor
        except (RuntimeError, ValueError):
            approval_anchor = "git_error"
            anchor_stable = False
        if not anchor_stable:
            for gate in gates:
                if gate["id"] == "G1/2":
                    gate["ok"] = False
                    gate["note"] = "批准快照在 dashboard 執行期間變了"
            attention.append({
                "tag": "無外部錨定", "title": "批准快照在 dashboard 執行期間變了",
                "body": "初次驗證的 mode/blob 與裁決前不同；必須重新產生證據與審查。",
            })

    stat = git(root, "diff", "--cached", "--shortstat").strip() or git(root, "diff", "--shortstat", f"{base}...HEAD").strip()
    context_name = (spec.get("meta") or {}).get("name", spec_path.parent.name)
    context = {
        "name": context_name,
        "branch": git(root, "rev-parse", "--abbrev-ref", "HEAD").strip(),
        "scale": stat or "—",
        "phase": "pre-commit" if pre_commit else "delivery",
        "approval_anchor": approval_anchor,
        "lane": spec_lane,
        "gates": gates, "attention": attention, "screenshots": shots,
    }
    # 命中率紀錄:哪道關擋過東西、擋了幾次,才有數據決定哪道關值得留。
    # append-only,跨功能累積。舊版有 disposition 標記做同一件事,重寫時被誤刪,這裡補回。
    yield_line = {
        "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "name": context_name,
        "lane": spec_lane,
        "gates": {g["id"]: g["ok"] for g in gates},
        "attention": [a["tag"] for a in attention],
        "review": findings.get("summary") or {},
    }
    with (root / "specs" / "_yield.jsonl").open("a") as fh:
        fh.write(json.dumps(yield_line, ensure_ascii=False) + "\n")

    out_path = pathlib.Path(argv[argv.index("-o") + 1]) if "-o" in argv else ev / "dashboard.html"
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(render(context))

    # 全綠、零待決事項才自動推;不然 PR 上必須有「需要你決定」。
    apply_lane_waivers()   # S 與 G9/10 已加入 —— 這一輪由白名單擋住它們
    all_green = all(g["ok"] for g in gates)
    for a in attention:
        a["decision"] = a["tag"] in DECISION_TAGS
    decisions = [a for a in attention if a["decision"]]
    context["auto_push_ok"] = (
        not pre_commit and all_green and not decisions and bool(config.get("auto_push", True))
    )
    write_json(ev / "dashboard.json", context)

    for g in gates:
        print(f"  {'✓' if g['ok'] else '✘'} {g['id']:<6} {g['what']:<22} {g['note']}")
    print(f"  → {out_path}")
    if pre_commit and all_green:
        verdict = "不行(pre-commit: commit 後須重跑 delivery dashboard)"
    elif context["auto_push_ok"]:
        verdict = "可以"
    elif not all_green:
        verdict = "不行(有關卡沒過)"
    elif decisions:
        verdict = "不行(有待決事項)"
    else:
        verdict = "不行(auto_push: false)"
    print(f"  自動推:{verdict}")
    for a in decisions:
        print(f"  ⏸ {a['title']}")

    # 狀態板自動填。實測九天沒人手動 `runs --set` 過一次:7 個在飛全是「尚未回報狀態」。
    # 證據表本來就知道卡在哪一關、在等誰,寫下去就好;格式與 runs --set 相同。
    first_red = next((g for g in gates if not g["ok"]), None)
    if first_red is not None:
        stage, label, blocked = "S9", f"卡在 {first_red['id']} {first_red['what']}", None
    elif decisions:
        stage, label, blocked = "S9", f"{len(decisions)} 條等你決定", "human"
    elif pre_commit:
        stage, label, blocked = "S9", "全綠,待 commit 後跑 delivery", None
    else:
        stage, label, blocked = "S10", "全綠零待決,可推", None
    write_json(ev / "status.json", {
        "stage": stage, "label": label, "blocked_on": blocked,
        "updated_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
    })
    return 0 if all_green else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
