#!/usr/bin/env python3
"""findings — 審查結果的四類分流。這就是迴圈不會無限的原因。

  must_fix   違反某組 example / 資安或架構違規   必附重現(會紅的測試、會命中的指令)→ 必修
  ask_user   example 沒涵蓋的 bug、極端 edge case   必附重現 + 問句 → 問人,不自動修
  overbuilt  example 外的公開介面、多一層抽象       必指名哪個介面沒有任何 example 用到 → 擋,拿掉
  style      內部囉嗦、命名                          不需證明 → 提醒,不擋

沒附重現的 must_fix / ask_user / overbuilt **收不進來**(證據規則)。
狀態:proposed → confirmed(重現實跑會紅)/ void(跑不紅)→ fixed / accepted_risk / added_example

用法:
  findings <spec.yaml> add --id F-001 --gate G10 --class must_fix --title "…" --repro "指令或測試路徑"
                           [--sc SC-003] [--question "要不要防這個?"]
  findings <spec.yaml> set F-001 confirmed|void|fixed|accepted_risk|added_example
  findings <spec.yaml> dispatched --gate G9|G10 [--model opus] [--degraded]
                           記「派過了」—— 零 finding 的乾淨審查也要留下派過的紀錄。
                           --degraded:該用的模型額度用完,退到次一級才派得出去(證據表會標出來)
  findings <spec.yaml> fix-diff [--merge <sha>]
                           印出「上次審過的樹 → 現在的樹」的 diff,給增量審查看。
                           --merge:改印那次併 main 的衝突解決(git show --remerge-diff)
  findings <spec.yaml> dispatched --gate G10-fix --finding F-001[,F-002] | --merge <sha> [--model opus]
                           記「增量審查派過了」:審的是 fix-diff 那段、為了哪幾條 finding(或哪次併 main)。
                           它不算 G10 重派;增量審查提出的新 finding 用 --gate G10-fix 收
  findings <spec.yaml> synced
                           S10¾ 併完 main 之後跑:本卡自己的改動沒變、衝突沒碰到 impact.files → 審查照算,
                           之後的 fix-diff 從併完的樹算起;否則點名要用 --merge 增量審查的那次併 main
  findings <spec.yaml> list
  findings <spec.yaml> check     還有沒有沒處理完的(proposed 也算)、或等人回答的 ask_user

同一個重現(repro)只能有一個 id:換 id 重 add 會被拒 —— 否則 loop 的計數會歸零。
退出碼(check): 0 乾淨 / 1 還有待處理或待決
"""

from __future__ import annotations

import datetime
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).parent))
from _common import (  # noqa: E402
    evidence_dir, impact_files, integration_branch, load_spec, read_json, repo_root, triage_findings, write_json,
)
from _state import EXCLUDED, branch_fingerprint, sync_merges, tree_fingerprint  # noqa: E402

CLASSES = {"must_fix", "ask_user", "overbuilt", "style"}
NEEDS_REPRO = {"must_fix", "ask_user", "overbuilt"}
STATUSES = {"proposed", "confirmed", "void", "fixed", "accepted_risk", "added_example"}


def keep_dispatch_tree(root: pathlib.Path, card: str, gate: str, tree: str) -> str | None:
    """被審的那棵樹留一個本機 ref,召回考題(scripts/bench/recall)之後才找得回「修正前」。

    派遣樹是 write-tree 寫出的孤兒物件,兩週後就被 git gc 清掉;流程到 S10 才第一次 commit,
    所以修正前的狀態只存在這裡。實測 152 條 fixed must_fix 只剩 35 條找得回。
    包成 commit(parent = 當時的 HEAD)再掛 ref:直接指向 tree 的 ref 會讓 `git log --all` 報錯。
    refs/pipeline/* 不是分支,一般的 push 不會帶上去。留不住只警告,不擋派遣紀錄。"""
    import os
    import subprocess
    env = {**os.environ, "GIT_AUTHOR_NAME": "pipeline", "GIT_AUTHOR_EMAIL": "pipeline@localhost",
           "GIT_COMMITTER_NAME": "pipeline", "GIT_COMMITTER_EMAIL": "pipeline@localhost"}
    head = subprocess.run(["git", "rev-parse", "--verify", "-q", "HEAD"], cwd=root, capture_output=True, text=True)
    parent = ["-p", head.stdout.strip()] if head.returncode == 0 else []
    made = subprocess.run(["git", "commit-tree", tree.removeprefix("tree:"), *parent,
                           "-m", f"pipeline: {card} {gate} 派遣時被審的樹"],
                          cwd=root, env=env, capture_output=True, text=True)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    ref = f"refs/pipeline/dispatch/{card}/{gate}/{stamp}"
    if made.returncode != 0 or subprocess.run(["git", "update-ref", ref, made.stdout.strip()],
                                              cwd=root, capture_output=True).returncode != 0:
        print(f"⚠ 派遣樹沒留住(召回考題會少一題):{(made.stderr or '').strip()[:120]}")
        return None
    return ref


def last_reviewed(state: dict) -> dict | None:
    """最近一次被審過的樹(整張審查、增量審查,或併完 main 確認照算的那棵),增量審查的 diff 從這裡算起。
    同一秒取後記的。"""
    records = [r for r in [*(state.get("dispatched") or {}).values(), *(state.get("increments") or []),
                           *(state.get("synced") or [])]
               if isinstance(r, dict) and isinstance(r.get("tree"), str)]
    try:
        return max(reversed(records), key=lambda r: datetime.datetime.fromisoformat(r["at"]), default=None)
    except (KeyError, TypeError, ValueError):
        return None   # 時間缺漏或格式錯:不猜從哪裡算起


def review_point(root: pathlib.Path) -> dict:
    """被審的那一刻:整棵樹(fix-diff 用),加上本卡自己改動的指紋與 merge-base(併 main 後還算不算數用)。"""
    point = {"tree": tree_fingerprint(root)}
    try:
        point["diff"], point["mb"] = branch_fingerprint(root, point["tree"], integration_branch(root))
    except RuntimeError as exc:
        print(f"⚠ {exc} —— 這次只記整棵樹,之後併 main 就會判審查過期")
    return point


def sync_merge(root: pathlib.Path, base: dict, sha: str) -> tuple[dict | None, str]:
    """--merge 點名的 commit 必須是「上次審查之後併進來的 main」。"""
    import subprocess
    if "mb" not in base:
        return None, "上次審查沒有記 merge-base(這個 PR 之前派的)—— 只能整張重審"
    full = subprocess.run(["git", "rev-parse", "--verify", "-q", f"{sha}^{{commit}}"],
                          cwd=root, capture_output=True, text=True).stdout.strip()
    try:
        merge = next((m for m in sync_merges(root, base["mb"], integration_branch(root)) if m["sha"] == full), None)
    except RuntimeError as exc:
        return None, str(exc)
    return merge, "" if merge else f"{sha} 不是上次審查之後併進來的 main"


def flag(argv: list[str], name: str) -> str | None:
    return argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else None


def load(ev: pathlib.Path) -> dict:
    return read_json(ev / "findings.json") or {"items": [], "dispatched": {}}


def summary(state: dict) -> dict:
    items = state["items"]
    return {
        "proposed": len(items),
        "void": sum(1 for i in items if i["status"] == "void"),
        "confirmed": sum(1 for i in items if i["status"] in ("confirmed", "fixed", "accepted_risk", "added_example")),
    }


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print(__doc__)
        return 2
    spec_path = pathlib.Path(argv[0]).resolve()
    root = repo_root(spec_path.parent)
    ev = evidence_dir(spec_path)
    verb = argv[1]
    state = load(ev)
    items = state["items"]

    if verb == "add":
        fid, gate, cls = flag(argv, "--id"), flag(argv, "--gate"), flag(argv, "--class")
        title, repro, question = flag(argv, "--title"), flag(argv, "--repro"), flag(argv, "--question")
        if not (fid and gate and cls and title):
            print("✘ 需要 --id --gate --class --title")
            return 2
        if cls not in CLASSES:
            print(f"✘ class 只能是 {', '.join(sorted(CLASSES))}")
            return 2
        if any(i["id"] == fid for i in items):
            print(f"✘ {fid} 已存在")
            return 2
        twin = next((i for i in items if repro and i.get("repro") == repro and i["status"] != "void"), None)
        if twin:
            print(f"✘ 同一個重現已經是 {twin['id']} —— 用原 id 繼續,換 id 等於把修復次數歸零")
            return 1
        if cls in NEEDS_REPRO and not (repro or "").strip():
            print(f"✘ {cls} 必須附重現(--repro)—— 跑不出來的主張不收")
            return 1
        if cls == "ask_user" and not (question or "").strip():
            print("✘ ask_user 必須附問句(--question)—— 人要回答的是一個問題,不是一段描述")
            return 1
        items.append({
            "id": fid, "gate": gate, "class": cls, "title": title, "sc": flag(argv, "--sc"),
            "repro": repro, "question": question, "status": "proposed",
            # 是哪個模型審出來的:沒有這欄就永遠回答不了「換模型之後審得有沒有比較差」
            **{k: v for k, v in ((state.get("increments") or [{}])[-1] if gate == "G10-fix"
                                 else (state.get("dispatched") or {}).get(gate, {})).items()
               if k in ("model", "degraded")},
            "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        })
        state["summary"] = summary(state)
        write_json(ev / "findings.json", state)
        print(f"{fid} [{cls}] {title}")
        return 0

    if verb == "fix-diff":
        base = last_reviewed(state)
        if base is None:
            print("✘ 還沒有派過整張審查(或紀錄的時間讀不懂)—— 增量審查要有「上次審過的樹」才算得出 diff")
            return 1
        import subprocess
        if flag(argv, "--merge"):
            merge, why = sync_merge(root, base, flag(argv, "--merge"))
            if merge is None:
                print(f"✘ {why}")
                return 1
            shown = subprocess.run(["git", "show", "--remerge-diff", "--format=", merge["sha"], "--", ".",
                                    *[f":(exclude){p}" for p in EXCLUDED]],
                                   cwd=root, capture_output=True, text=True, errors="replace")
            print(f"併 main {merge['sha'][:10]} 的衝突解決(自動合併的結果 → 實際 commit 的版本)")
            print(shown.stdout, end="")
            return shown.returncode
        point = review_point(root)
        if "mb" in base and point.get("mb") != base["mb"]:
            print("✘ 上次審查之後併過 main —— 直接 diff 會混進 main 的改動。先跑 `findings synced`;"
                  "它點名的那次併 main 用 `fix-diff --merge <sha>`")
            return 1
        current = point["tree"]
        print(f"上次審過 {base['tree']} → 現在 {current}")
        if base["tree"] == current:
            print("審查之後沒有變更")
            return 0
        diff = subprocess.run(["git", "diff", "--no-renames", base["tree"].removeprefix("tree:"),
                               current.removeprefix("tree:")], cwd=root, capture_output=True, text=True, errors="replace")
        if diff.returncode != 0:
            print(f"✘ 算不出 diff(上次審過的樹可能被 gc 了,只能整張重審):{diff.stderr.strip()[:200]}")
            return 1
        print(diff.stdout, end="")
        return 0

    if verb == "dispatched" and flag(argv, "--gate") == "G10-fix":
        fids = [f for f in (flag(argv, "--finding") or "").split(",") if f]
        sha = flag(argv, "--merge")
        known = {i["id"] for i in items}
        if bool(fids) == bool(sha) or set(fids) - known:
            print("✘ --finding(這次修的 finding,都要在 findings.json 裡)和 --merge(這次審的併 main)要給一個"
                  f"(不認得:{', '.join(sorted(set(fids) - known)) or '沒有'})")
            return 2
        base = last_reviewed(state)
        if base is None:
            print("✘ 還沒有派過整張審查(或紀錄的時間讀不懂)—— 沒有可以接的樹")
            return 1
        merge, why = sync_merge(root, base, sha) if sha else (None, "")
        if sha and merge is None:
            print(f"✘ {why}")
            return 1
        state.setdefault("increments", []).append({
            "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "base": base["tree"], **({"base_diff": base["diff"]} if "diff" in base else {}),
            **review_point(root), **({"merge": merge["sha"]} if merge else {"findings": fids}),
            **({"model": flag(argv, "--model")} if flag(argv, "--model") else {}),
        })
        write_json(ev / "findings.json", state)
        print(f"G10-fix 派過了({', '.join(fids) if fids else '併 main ' + merge['sha'][:10]})")
        return 0

    if verb == "synced":
        base = last_reviewed(state)
        if base is None or "diff" not in base:
            print("✘ 上次審查沒有本卡改動的指紋(還沒派過,或是這個 PR 之前派的)—— 併 main 之後只能整張重審")
            return 1
        point = review_point(root)
        if "diff" not in point:
            return 1
        if point["mb"] == base["mb"]:
            print("上次審查之後沒有併進新的 main")
            return 0
        try:
            merges = sync_merges(root, base["mb"], integration_branch(root))
        except RuntimeError as exc:
            print(f"✘ {exc}")
            return 1
        impact = impact_files(load_spec(spec_path))
        touched = {m["sha"] for m in merges if set(m["files"]) & impact}
        if touched or point["diff"] != base["diff"]:
            if point["diff"] != base["diff"]:
                print("✘ 本卡自己的改動和上次審查時不一樣了")
            for m in merges:
                if m["files"]:
                    print(f"  併 main {m['sha'][:10]} 的衝突解決動到:{', '.join(m['files'])}"
                          + (" ← 有本卡 impact.files 的檔" if m["sha"] in touched else ""))
            print("→ 點名的那次併 main:fix-diff --merge <sha> 給 fix-reviewer 看,再 dispatched --gate G10-fix --merge <sha>。"
                  "改動變了卻沒有衝突解決可以審(例如審查後還有沒審的修正)→ 整張重審")
            return 1
        state.setdefault("synced", []).append({
            "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "base": base["tree"], **point, "merges": [m["sha"] for m in merges],
        })
        write_json(ev / "findings.json", state)
        print("✓ 審查照算:本卡自己的改動沒變,衝突沒碰到 impact.files。接著重跑 smoke 與 dashboard --trigger merge-main")
        return 0

    if verb == "dispatched":
        gate = flag(argv, "--gate")
        if gate not in ("G9", "G10"):
            print("✘ --gate 只能是 G9、G10 或 G10-fix")
            return 2
        point = review_point(root)
        keep = keep_dispatch_tree(root, spec_path.parent.name, gate, point["tree"])
        state.setdefault("dispatched", {})[gate] = {
            "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            **point,
            **({"keep": keep} if keep else {}),
            **({"model": flag(argv, "--model")} if flag(argv, "--model") else {}),
            **({"degraded": True} if "--degraded" in argv else {}),
        }
        state["summary"] = summary(state)
        write_json(ev / "findings.json", state)
        print(f"{gate} 派過了")
        return 0

    if verb == "set":
        fid, status = (argv[2] if len(argv) > 2 else None), (argv[3] if len(argv) > 3 else None)
        item = next((i for i in items if i["id"] == fid), None)
        if item is None or status not in STATUSES:
            print(f"✘ 找不到 {fid} 或狀態不合法({', '.join(sorted(STATUSES))})")
            return 2
        if item["class"] == "ask_user" and status == "fixed":
            print("✘ ask_user 不能直接 fixed —— 人說要防就 added_example,不要就 accepted_risk")
            return 1
        item["status"] = status
        state["summary"] = summary(state)
        write_json(ev / "findings.json", state)
        print(f"{fid} → {status}")
        return 0

    if verb in ("list", "check"):
        pending, asking = triage_findings(items)
        for i in items:
            mark = "✘" if i in pending else ("?" if i in asking else " ")
            print(f"  {mark} {i['id']:<7} {i['class']:<10} {i['status']:<14} {i['title'][:60]}")
        s = summary(state)
        print(f"提出 {s['proposed']} → 作廢 {s['void']} → 證實 {s['confirmed']}")
        if verb == "list":
            return 0
        if pending:
            print(f"findings: 還有 {len(pending)} 條必修沒處理")
        if asking:
            print(f"findings: {len(asking)} 條等你決定")
        print(f"findings: {'OK' if not pending and not asking else 'PENDING'}")
        return 1 if pending or asking else 0

    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
