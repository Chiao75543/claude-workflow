BACKUP = HERE / ".mutate-backup"


def restore_leftovers() -> list[str]:
    """上一次跑到一半被砍(例如系統記憶體不足送 SIGKILL)時,finally 不會執行,
    腳本會停在被改壞的狀態。實際發生過一次:dashboard 留著一條 `if False:`。
    所以注入前先落備份,啟動時先把殘留的備份還回去。"""
    restored = []
    if BACKUP.is_dir():
        for bak in sorted(BACKUP.iterdir()):
            target = GATES / bak.name
            target.write_text(bak.read_text())
            bak.unlink()
            restored.append(bak.name)
        BACKUP.rmdir()
    return restored


def run_tests() -> bool:
    proc = subprocess.run([str(HERE / "run")], capture_output=True, text=True)
    return proc.returncode == 0


def main(argv: list[str]) -> int:
    max_survivors = 0
    if "--max-survivors" in argv:
        max_survivors = int(argv[argv.index("--max-survivors") + 1])
    only = {argv[i + 1] for i, a in enumerate(argv) if a == "--only" and i + 1 < len(argv)}
    mutations = [m for m in MUTATIONS if not only or m[0] in only]

    leftovers = restore_leftovers()
    if leftovers:
        print(f"⚠ 上次沒跑完,已從備份還原: {', '.join(leftovers)}")

    if not run_tests():
        print("✘ 基線就沒過,先修好測試再談變異")
        return 2

    survived, killed, skipped = [], [], []  # skipped: (script, label, reason)
    for script, label, find, replace in mutations:
        path = GATES / script
        original = path.read_text()
        occurrences = original.count(find)
        if occurrences == 0:
            skipped.append((script, label, "找不到注入點"))
            continue
        if occurrences > 1:
            # 歧義的變異會靜默打到第一個出現處,測出來的結果是假的。
            # 一個會說謊的工具比沒有工具更糟。
            skipped.append((script, label, f"注入點出現 {occurrences} 次,有歧義"))
            continue
        BACKUP.mkdir(exist_ok=True)
        bak = BACKUP / script
        bak.write_text(original)          # 先落備份,被砍也還得回來
        try:
            path.write_text(original.replace(find, replace, 1))
            (survived if run_tests() else killed).append((script, label))
        finally:
            path.write_text(original)
            bak.unlink(missing_ok=True)
    if BACKUP.is_dir() and not any(BACKUP.iterdir()):
        BACKUP.rmdir()

    total = len(survived) + len(killed)
    for script, label in survived:
        print(f"  存活  {script:<14} {label}")
    if skipped:
        print()
        for script, label, reason in skipped:
            print(f"  跳過  {script:<14} {label}  ({reason})")
    rate = len(survived) / total * 100 if total else 0
    print(f"\n{len(killed)}/{total} 被殺 · 存活 {len(survived)} ({rate:.0f}%)")
    if len(survived) > max_survivors:
        print(f"存活數超過容忍值 {max_survivors} —— 這些行為目前沒有測試守著")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
