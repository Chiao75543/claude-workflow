#!/usr/bin/env python3
"""test-review — S7½:凍結之前,先審測試本身。

凍結錯的測試比沒凍結更糟 —— 實作者只能一直「衝突就停」。所以上鎖前看三件事:

  機械(這支腳本)
    · 每條測試至少有一個斷言(零斷言 = 空測試)
    · 每條測試至少引用它那條 Scenario 某組 example 的**具體值**(不是只看型別)
    · 每組 example 至少被一條測試引用(批准的例子沒人測 = 契約沒被測)
  語意(opus 派遣的 test-reviewer,結果寫在 evidence/test-review.agent.json)
    · 斷言對的是不是那個值該出現的地方、case 名稱看不看得出在測什麼

機械檢查只能驗「值有出現」,抓不到「值對了但斷在錯的地方」—— 那是派遣存在的理由。
派遣的每條 finding 也得指名「哪條測試、缺哪個值」,否則不算數(證據規則)。

結果寫 evidence/test-review.json,連同每個測試檔的指紋 ——
dashboard 用它確認「審過的」和「凍結的」是同一批檔案。

用法: test-review <spec.yaml> [--mechanical-only]
退出碼: 0 通過 / 1 有問題
"""

from __future__ import annotations

import datetime
import hashlib
import json
import pathlib
import re
import sys

sys.path.insert(0, str(pathlib.Path(__file__).parent))
import _config  # noqa: E402
from _common import (  # noqa: E402
    RED_MODES, SMOKE_MODES, Findings, evidence_dir, invalid_scenario_modes, load_spec,
    read_json, scenario_ids_for_modes, scenarios, spec_test_sources, write_json,
)
from _state import tree_fingerprint  # noqa: E402
from _workflow_schemas import schema_for  # noqa: E402

SKIP_TOKENS = {"true", "false", "null", "none", "nil", "yes", "no"}
# 註解裡的東西不算:`// #expect(...) 之後補` 不是斷言,`// emptyList` 不是引用。
# `#` 開頭只在後面接空白時當註解(Python / shell),否則會把 Swift 的 #expect 剝掉。
COMMENT = re.compile(r"/\*.*?\*/|//[^\n]*|^\s*#\s[^\n]*", re.S | re.M)


def canonical_rel(rel: str) -> bool:
    value = pathlib.PurePosixPath(rel)
    return bool(rel) and not value.is_absolute() and ".." not in value.parts and value.as_posix() == rel


def regular_repo_file(root: pathlib.Path, rel: str) -> bool:
    if not canonical_rel(rel):
        return False
    cursor = root
    for part in pathlib.PurePosixPath(rel).parts:
        cursor = cursor / part
        if cursor.is_symlink():
            return False
    return cursor.is_file()


def expected_reviewed_examples(spec: dict) -> list[dict]:
    rows = [
        {"scenario": str(sc.get("id")), "examples": list(range(1, len(sc.get("examples") or []) + 1))}
        for _, sc in scenarios(spec) if sc.get("mode") in RED_MODES
    ]
    return sorted(rows, key=lambda item: item["scenario"])


def valid_test_records(value: object) -> bool:
    if not isinstance(value, list) or not value:
        return False
    seen = set()
    for row in value:
        if (not isinstance(row, dict) or set(row) != {"path", "sha256"}
                or not isinstance(row.get("path"), str) or not canonical_rel(row["path"])
                or row["path"] in seen
                or re.fullmatch(r"sha256:[0-9a-f]{64}", str(row.get("sha256", ""))) is None):
            return False
        seen.add(row["path"])
    return value == sorted(value, key=lambda row: row["path"])


def valid_agent_schema(agent: object, expected_examples: list[dict]) -> bool:
    required = {
        "schema_version", "writer_task_ref", "reviewer_task_ref", "completion_ref", "tree_token",
        "created_at", "status", "findings", "before_tests", "after_tests",
        "assertion_weakened", "reviewed_examples",
    }
    if not isinstance(agent, dict) or set(agent) != required or agent.get("schema_version") != 1:
        return False
    if (any(not isinstance(agent.get(key), str) or not agent[key]
            for key in ("writer_task_ref", "reviewer_task_ref", "completion_ref"))
            or re.fullmatch(r"tree:(?:[0-9a-f]{40}|[0-9a-f]{64})", str(agent.get("tree_token", ""))) is None
            or re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})",
                            str(agent.get("created_at", ""))) is None
            or agent.get("status") not in {"passed", "blocking"}
            or not valid_test_records(agent.get("before_tests"))
            or not valid_test_records(agent.get("after_tests"))
            or not isinstance(agent.get("assertion_weakened"), bool)
            or agent.get("reviewed_examples") != expected_examples):
        return False
    findings = agent.get("findings")
    if not isinstance(findings, list):
        return False
    return all(
        isinstance(item, dict) and set(item) == {"test", "sc", "problem", "blocking"}
        and isinstance(item.get("test"), str) and bool(item["test"])
        and re.fullmatch(r"SC-[0-9]{3}[a-z]?", str(item.get("sc", ""))) is not None
        and isinstance(item.get("problem"), str) and bool(item["problem"])
        and isinstance(item.get("blocking"), bool)
        for item in findings
    )


def red_contract_valid(root: pathlib.Path, spec_path: pathlib.Path, dispatch: dict,
                       expected_examples: list[dict]) -> bool:
    red = read_json(evidence_dir(spec_path) / "red.json")
    if (not isinstance(red, dict) or red.get("schema_version") != 1 or red.get("status") != "passed"
            or red.get("spec_hash") != "sha256:" + hashlib.sha256(spec_path.read_bytes()).hexdigest()):
        return False
    expected_pairs = {(row["scenario"], index) for row in expected_examples for index in row["examples"]}
    actual_pairs: set[tuple[str, int]] = set()
    for row in red.get("runner_results") or []:
        failure_class = row.get("failure_class") if isinstance(row, dict) else None
        exempt = (failure_class == "exempt" and isinstance(red.get("exemptions"), dict)
                  and row.get("scenario") in red["exemptions"])
        if (not isinstance(row, dict) or row.get("red_valid") is not True
                or failure_class not in {"assertion", "exempt"} or (failure_class == "exempt" and not exempt)
                or row.get("tree_token") != dispatch.get("tree_token")):
            return False
        scenario, example = row.get("scenario"), row.get("example")
        if not isinstance(scenario, str) or isinstance(example, bool) or not isinstance(example, int):
            return False
        actual_pairs.add((scenario, example))
        streams: list[bytes] = []
        for key in ("stdout_path", "stderr_path"):
            rel = row.get(key)
            if not isinstance(rel, str) or not regular_repo_file(root, rel):
                return False
            payload = (root / rel).read_bytes()
            recorded = row.get(key.replace("_path", "_sha256"))
            if recorded is not None and recorded != "sha256:" + hashlib.sha256(payload).hexdigest():
                return False
            streams.append(payload)
        if (not exempt
                and not any(line.startswith(b"STATIC_ASSERTION:") for payload in streams for line in payload.splitlines())):
            return False
    return actual_pairs == expected_pairs


def strip_comments(text: str) -> str:
    return COMMENT.sub("", text)


def camel(token: str) -> str:
    head, *rest = token.split("_")
    return head + "".join(w[:1].upper() + w[1:] for w in rest)


def leaves(value):
    if isinstance(value, dict):
        for v in value.values():
            yield from leaves(v)
    elif isinstance(value, list):
        for v in value:
            yield from leaves(v)
    else:
        yield value


def anchors_of(example: dict) -> list[tuple[str, re.Pattern]]:
    """一組 example 的 out 裡,哪些值可以拿來在測試裡找。布林與 null 太泛,不算。"""
    out = []
    for leaf in leaves(example.get("out")):
        if isinstance(leaf, bool) or leaf is None:
            continue
        if isinstance(leaf, (int, float)):
            out.append((str(leaf), re.compile(rf"(?<![\w.]){re.escape(str(leaf))}(?![\w.])")))
            continue
        text = str(leaf).strip()
        if len(text) < 2 or text.lower() in SKIP_TOKENS:
            continue
        forms = {text, camel(text)} if "_" in text else {text}
        out.append((text, re.compile("|".join(re.escape(f) for f in forms), re.I)))
    return out


def boolean_signatures_of(example: dict) -> list[tuple[str, re.Pattern, re.Pattern]]:
    """布林/null 沒有可單獨搜尋的值，改用「輸出欄位名 + 字面值」辨識。

    只找 true/false 會讓任何布林斷言都能冒充契約；只找欄位名則可能只是取值。
    兩者同時出現在測試 body，才把它視為 anchorless example 的機械證據。
    """
    out = []

    def walk(value, key: str | None = None) -> None:
        if isinstance(value, dict):
            for child_key, child_value in value.items():
                walk(child_value, str(child_key))
            return
        if isinstance(value, list):
            for child in value:
                walk(child, key)
            return
        if key is None or (not isinstance(value, bool) and value is not None):
            return
        forms = {key, camel(key)} if "_" in key else {key}
        key_rx = re.compile("|".join(re.escape(form) for form in forms), re.I)
        literals = ("nil", "null", "none") if value is None else (("true",) if value else ("false",))
        value_rx = re.compile(r"\b(?:" + "|".join(literals) + r")\b", re.I)
        out.append((key, key_rx, value_rx))

    walk(example.get("out"))
    return out


def matches_example(body: str, anchors: list[tuple[str, re.Pattern]],
                    boolean_signatures: list[tuple[str, re.Pattern, re.Pattern]]) -> bool:
    if anchors:
        return any(rx.search(body) for _, rx in anchors)
    return any(key_rx.search(body) and value_rx.search(body)
               for _, key_rx, value_rx in boolean_signatures)


def collect_tests(config: dict, sources: list[dict]) -> list[dict]:
    """[{file, sc, name, body}] —— body 是這條測試到下一條測試之間的文字。"""
    pattern = re.compile(config["tests"]["scenario_pattern"])
    tests = []
    for source in sources:
        text = source["text"]
        matches = list(pattern.finditer(text))
        for i, m in enumerate(matches):
            end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
            line_end = text.find("\n", m.start())
            line_end = line_end if line_end > 0 else end
            # 描述字串不算 body:命名慣例會把 example 的值寫進名字,那不是斷言。
            # 只剝到字串收尾的引號,單行測試的斷言還在。
            quote = text.find('"', m.end())
            body_start = quote + 1 if 0 <= quote < line_end else line_end
            tests.append({
                "file": source["rel"],
                "sc": m.group(1),
                "name": text[m.start():line_end].strip()[:80],
                "body": strip_comments(text[body_start:end]),
            })
    return tests


def main(argv: list[str]) -> int:
    if argv == ["--help"]:
        print(__doc__)
        return 0
    if argv == ["--schema"]:
        print(json.dumps(schema_for("test-review"), sort_keys=True, separators=(",", ":")))
        return 0
    if any(arg.startswith("-") and arg != "--mechanical-only" for arg in argv):
        print(json.dumps({"status": "rejected", "reason": "invalid_cli", "exit_code": 2}, sort_keys=True, separators=(",", ":")))
        return 2
    args = [a for a in argv if not a.startswith("-")]
    if not args:
        print(__doc__)
        return 2
    spec_path = pathlib.Path(args[0]).resolve()
    root = spec_path.parents[2]
    ev = evidence_dir(spec_path)
    spec = load_spec(spec_path)
    config = _config.load(root)
    legacy_v0 = _config.autonomy_version(config)[0] == 0
    f = Findings()
    rejection_reason = None

    for sid, mode in invalid_scenario_modes(spec):
        f.error(sid, f"未知或缺少 mode {mode!r} —— 不能靜默略過測試審查")

    assert_re = re.compile(config["assert_pattern"])
    test_sources, scope_source, scope_errors = spec_test_sources(root, spec_path, config)
    for message in scope_errors:
        f.error("測試範圍", message)
    tests = collect_tests(config, test_sources)
    current_file_records = [
        {"path": source["rel"], "sha256": source["sha256"]}
        for source in sorted(test_sources, key=lambda item: item["rel"])
    ]

    # static-command 的 checker 及其 repo-local manifest 依賴都必須列在
    # red-inputs.tests，否則審查與凍結只涵蓋入口檔，依賴可在之後偷換。
    red_inputs = read_json(ev / "red-inputs.json") or []
    for entry in red_inputs:
        if not isinstance(entry, dict) or entry.get("runner", config.get("runner")) != "static-command":
            continue
        declared = set(entry.get("tests") or [])
        referenced = set()
        for token in entry.get("argv") or []:
            candidate = root / token
            if candidate.is_file():
                referenced.add(str(candidate.relative_to(root)))
        for rel in sorted(declared):
            source = root / rel
            if not source.is_file():
                continue
            text = strip_comments(source.read_text(errors="ignore"))
            for match in re.finditer(r"(?:open|Path)\(\s*['\"]([^'\"]+)['\"]", text):
                candidate = (source.parent / match.group(1)).resolve()
                if not candidate.is_file():
                    candidate = (root / match.group(1)).resolve()
                try:
                    local = str(candidate.relative_to(root))
                except ValueError:
                    continue
                # The approved spec is already independently hashed and is the
                # input under review, not a mutable checker dependency.
                if candidate == spec_path:
                    continue
                if candidate.is_file():
                    referenced.add(local)
        undeclared = sorted(referenced - declared)
        if undeclared:
            rejection_reason = "undeclared_static_dependency"
            f.error(str(entry.get("layer", "static-command")),
                    f"未宣告 static dependency: {', '.join(undeclared)}")
    by_sc: dict[str, list[dict]] = {}
    for t in tests:
        by_sc.setdefault(t["sc"], []).append(t)

    for _, sc in scenarios(spec):
        sid = sc.get("id")
        if sc.get("mode") not in RED_MODES:
            continue
        if not by_sc.get(sid):
            f.error(str(sid), "沒有任何本 spec 測試引用這條 Scenario")
        examples = [e for e in (sc.get("examples") or []) if isinstance(e, dict)]
        example_anchors = [anchors_of(e) for e in examples]
        example_boolean_signatures = [boolean_signatures_of(e) for e in examples]
        for i, (anchors, signatures) in enumerate(zip(example_anchors, example_boolean_signatures), 1):
            if not anchors and not signatures:
                f.warn(f"{sid} example #{i}", "out 沒有可辨識的具體值或布林欄位 —— 交給語意審查")

        for t in by_sc.get(sid, []):
            where = f"{t['file']} · {t['name']}"
            if not assert_re.search(t["body"]):
                f.error(where, "沒有任何斷言 —— 空測試")
            if any(example_anchors) or any(example_boolean_signatures):
                matched = any(
                    matches_example(t["body"], anchors, signatures)
                    for anchors, signatures in zip(example_anchors, example_boolean_signatures)
                )
            else:
                matched = True
            if not matched:
                wanted = sorted({a for anchors in example_anchors for a, _ in anchors})[:5]
                wanted += sorted({key for signatures in example_boolean_signatures for key, _, _ in signatures})[:5]
                f.error(where, f"沒有引用 {sid} 任何一組 example 的具體輸出(例如 {', '.join(wanted)})")

        for i, (anchors, signatures) in enumerate(zip(example_anchors, example_boolean_signatures), 1):
            if not anchors and not signatures:
                continue
            if not any(matches_example(t["body"], anchors, signatures) for t in by_sc.get(sid, [])):
                f.error(f"{sid} example #{i}", "沒有任何測試引用這組 example 的值 —— 批准的例子沒人測")

    agent = None
    dispatch = read_json(ev / "review-dispatch.json")
    if "--mechanical-only" not in argv:
        agent = read_json(ev / "test-review.agent.json")
        if agent is None:
            f.error("語意審查", "缺 evidence/test-review.agent.json —— test-reviewer 還沒派,或它沒寫結果")
        else:
            if not legacy_v0:
                expected_examples = expected_reviewed_examples(spec)
                agent_schema_ok = valid_agent_schema(agent, expected_examples)
                refs = ("writer_task_ref", "reviewer_task_ref", "completion_ref", "tree_token")
                if (not agent_schema_ok or not isinstance(dispatch, dict) or dispatch.get("schema_version") != 1
                        or agent.get("schema_version") != 1
                        or any(not isinstance(agent.get(key), str) or not agent.get(key) for key in refs)
                        or any(agent.get(key) != dispatch.get(key) for key in refs)
                        or agent.get("writer_task_ref") == agent.get("reviewer_task_ref")
                        or agent.get("status") != "passed"):
                    rejection_reason = "invalid_independent_review"
                    f.error("語意審查", "agent 與 dispatch 的獨立審查欄位不一致")
                agent_before = agent.get("before_tests")
                agent_after = agent.get("after_tests")
                if (not isinstance(agent_before, list) or not agent_before
                        or not isinstance(agent_after, list) or not agent_after):
                    rejection_reason = "invalid_independent_review"
                    f.error("語意審查", "before_tests/after_tests 必須是非空測試快照")
                elif "before_tests" in agent and "after_tests" in agent and agent_before == agent_after:
                    rejection_reason = "invalid_independent_review"
                    f.error("語意審查", "before_tests/after_tests 沒有呈現受審變更")
                if not isinstance(agent.get("assertion_weakened"), bool):
                    rejection_reason = "invalid_independent_review"
                    f.error("語意審查", "assertion_weakened 必須明確為 boolean")
                elif agent.get("assertion_weakened") is True:
                    rejection_reason = "assertion_weakened"
                    f.error("語意審查", "reviewer 判定斷言被弱化")
                if "reviewed_examples" not in agent or agent.get("reviewed_examples") != expected_examples:
                    rejection_reason = "invalid_independent_review"
                    f.error("語意審查", "reviewed_examples 未精確涵蓋核准 scenarios/examples")
                if isinstance(dispatch, dict) and not red_contract_valid(root, spec_path, dispatch, expected_examples):
                    if rejection_reason is None:
                        rejection_reason = "stale_red_evidence"
                    f.error("RED", "raw stream、hash、marker、coverage 或 tree token 已漂移")
            for item in agent.get("findings") or [] if isinstance(agent, dict) else []:
                if not isinstance(item, dict):
                    continue
                spot = f"{item.get('test', '?')} ({item.get('sc', '?')})"
                if not item.get("test") or not item.get("problem"):
                    f.warn(spot, "finding 沒指名測試或問題,依證據規則作廢")
                    continue
                (f.error if item.get("blocking") else f.warn)(spot, str(item["problem"]))

    files = sorted({source["rel"] for source in test_sources})
    deferred_smoke = sorted(scenario_ids_for_modes(spec, SMOKE_MODES))
    if deferred_smoke:
        f.warn("延後驗證", f"{', '.join(deferred_smoke)} 是 6c,由 S9b smoke 審查實跑證據,不以 @Test 冒充")
    code = f.report("test-review")
    file_records = current_file_records
    reviewed_examples = expected_reviewed_examples(spec)
    valid_agent = valid_agent_schema(agent, reviewed_examples) if not legacy_v0 else isinstance(agent, dict)
    before_tests = agent.get("before_tests") if valid_agent and not legacy_v0 else file_records
    after_tests = agent.get("after_tests") if valid_agent and not legacy_v0 else file_records
    assertion_weakened = agent.get("assertion_weakened") if valid_agent and not legacy_v0 else False
    review_token = None
    if valid_agent and not legacy_v0:
        token_input = {
            "writer_task_ref": agent.get("writer_task_ref"),
            "reviewer_task_ref": agent.get("reviewer_task_ref"),
            "completion_ref": agent.get("completion_ref"),
            "tree_token": agent.get("tree_token"),
            "before_tests": before_tests,
            "after_tests": after_tests,
            "assertion_weakened": assertion_weakened,
            "reviewed_examples": reviewed_examples,
        }
        canonical = json.dumps(token_input, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
        review_token = "sha256:" + hashlib.sha256(canonical.encode()).hexdigest()
    payload = {
        "ok": code == 0,
        "mechanical_only": "--mechanical-only" in argv,
        "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
        "tests": len(tests),
        "scope_source": scope_source,
        "reviewed_modes": sorted(RED_MODES),
        "deferred_smoke": deferred_smoke,
        "files": {source["rel"]: source["sha256"] for source in test_sources if source["rel"] in files},
        "tree": tree_fingerprint(root),
        "errors": [f"{w}: {m}" for w, m in f.errors],
        "warnings": [f"{w}: {m}" for w, m in f.warnings],
        "agent": agent if legacy_v0 or valid_agent else None,
    }
    if not legacy_v0:
        payload = {
            "schema_version": 1,
            "status": "rejected" if rejection_reason else ("passed" if code == 0 else "failed"),
            "reason": rejection_reason,
            **payload,
            "before_tests": before_tests,
            "after_tests": after_tests,
            "assertion_weakened": assertion_weakened,
            "reviewed_examples": reviewed_examples,
            "review_token": review_token,
            "reviewed_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "exit_code": 1 if rejection_reason else code,
        }
    write_json(ev / "test-review.json", payload)
    if not legacy_v0:
        print(json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
        return int(payload["exit_code"])
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
