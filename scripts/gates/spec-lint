#!/usr/bin/env python3
"""spec-lint — 規格的機械檢查(S6 / G1 前置)。

三類:
  schema    必要欄位、型別、ID 唯一且可解析
  完備性    每個 Requirement 對六類遺漏逐項表態:列 Scenario,或寫「N/A + 理由」
  可測性    then 必須是結構化 mapping;examples 必須是具體字面值;
            6d(只能人工驗)必須說明為何不能自動化

設計理由:規格只給 AI 讀,所以不必是散文。改成結構化之後,
「正確地處理」這種空話**根本沒有欄位可以放** —— 不是被偵測到,是寫不進去。
詞彙黑名單只是最後一道網,擋那些硬塞進字串值的。

用法: spec-lint <spec.yaml> [more.yaml ...]
退出碼: 0 通過 / 1 有錯誤
"""

from __future__ import annotations

import pathlib
import re
import sys

sys.path.insert(0, str(pathlib.Path(__file__).parent))
from _common import (  # noqa: E402
    COMPLETENESS_CATEGORIES, MODES, NAME, REQUIREMENT_ID, RISK_FLAGS, SCENARIO_ID,
    Findings, load_spec, scenarios,
)

# 最後一道網:硬塞進字串值的空話。schema 已經擋掉大部分。
VAGUE = [
    "正確", "適當", "合理", "正常", "良好", "妥善", "應該要能", "符合預期", "成功處理",
    "沒問題", "順利", "等等", "若干", "一些", "快速", "大量", "足夠",
    "correct", "appropriate", "proper", "reasonable", "properly", "gracefully",
    "as expected", "and so on", "etc.", "fast enough", "works", "valid", "handled",
    "successfully", "fine", "ok",
]
# then / out 的葉值要是**具體的值**,不是一句話。超過這個長度的字串幾乎都是散文。
# 黑名單本質上隨手可繞(對抗審查實證),長度上限才是結構性的門。
# 中文密度高 —— 20 個字已經是一整句,門檻要分開設(33 字的中文句子曾經因為 <40 而漏過)。
LEAF_MAX = 40
LEAF_MAX_CJK = 20
CJK = re.compile(r"[\u3000-\u9fff\uf900-\ufaff]")
# CJK 字元屬於 \w,所以「內容待補」兩側都沒有 word boundary —— \b 對它完全無效。
# 拉丁字用 \b,CJK 用裸比對。
PLACEHOLDER = re.compile(r"\b(TBD|TODO|FIXME|XXX)\b|(待補|待定|待確認|暫定)", re.I)

REQUIRED_TOP = ["meta", "why", "what", "impact", "requirements"]


def prose_limit(text: str) -> int | None:
    """回傳這個字串適用的長度上限;None 表示它是 token,不受長度規則管。
    有空白或中文的是句子;沒有空白、純 ASCII 的是 token(query 參數、識別字、URL),
    例如 created_at.desc.nullslast,id.desc.nullslast。"""
    if CJK.search(text):
        return LEAF_MAX_CJK
    if re.search(r"\s", text):
        return LEAF_MAX
    return None


def walk_strings(node, trail=""):
    """走訪巢狀結構裡所有字串值,回傳 (路徑, 值)。"""
    if isinstance(node, dict):
        for key, value in node.items():
            yield from walk_strings(value, f"{trail}.{key}" if trail else str(key))
    elif isinstance(node, list):
        for index, value in enumerate(node):
            yield from walk_strings(value, f"{trail}[{index}]")
    elif isinstance(node, str):
        yield trail, node


def check_schema(spec: dict, f: Findings) -> None:
    for key in REQUIRED_TOP:
        if key not in spec:
            f.error("(頂層)", f"缺少必要區塊 `{key}`")

    meta = spec.get("meta")
    if isinstance(meta, dict):
        name = meta.get("name")
        if not name or not NAME.match(str(name)):
            f.error("meta.name", f"必須是 kebab-case 名稱,得到 {name!r}")
        if meta.get("change_type") not in {"ADDED", "MODIFIED"}:
            f.error("meta.change_type", "必須是 ADDED 或 MODIFIED")
        # 車道旗標:要嘛不寫(走 full),要嘛六個全寫成 true/false。寫一半會讓人以為已經評估過。
        flags = meta.get("risk_flags")
        if flags is not None:
            if not isinstance(flags, dict):
                f.error("meta.risk_flags", "必須是 mapping(六個旗標各填 true/false),或整個不寫(走 full 車道)")
            else:
                missing = [k for k in RISK_FLAGS if k not in flags]
                bad = [k for k in RISK_FLAGS if k in flags and not isinstance(flags[k], bool)]
                unknown = [k for k in flags if k not in RISK_FLAGS]
                if missing:
                    f.error("meta.risk_flags", f"六個旗標要全填,缺 {', '.join(missing)}")
                if bad:
                    f.error("meta.risk_flags", f"只能是 true/false: {', '.join(bad)}")
                if unknown:
                    f.error("meta.risk_flags", f"不認得的旗標: {', '.join(unknown)}(只有 {', '.join(RISK_FLAGS)})")
    else:
        f.error("meta", "必須是 mapping")

    impact = spec.get("impact")
    if isinstance(impact, dict):
        if not impact.get("files"):
            f.error("impact.files", "必須列出受影響的檔案(scope audit 的產出)")
        if not impact.get("call_sites"):
            f.error("impact.call_sites", "必須列出受影響的呼叫點,或明寫「無既有呼叫點」")
    else:
        f.error("impact", "必須是 mapping")

    reqs = spec.get("requirements")
    if not isinstance(reqs, list) or not reqs:
        f.error("requirements", "必須是非空的 list")
        return

    seen_req: set[str] = set()
    seen_sc: set[str] = set()
    for req in reqs:
        if not isinstance(req, dict):
            f.error("requirements[]", "每個 Requirement 必須是 mapping")
            continue
        rid = req.get("id")
        where = str(rid or "(無 id 的 Requirement)")
        if not rid or not REQUIREMENT_ID.match(str(rid)):
            f.error(where, "id 必須形如 REQ-001")
        elif rid in seen_req:
            f.error(where, "id 重複")
        else:
            seen_req.add(rid)
        if not str(req.get("statement") or "").strip():
            f.error(where, "缺少 statement")
        entries = req.get("scenarios")
        if not entries:
            f.error(where, "至少要有一條 Scenario")
        elif isinstance(entries, list):
            # 寫成 [SC-001, SC-002] 這種字串 list 的話,scenarios() 會全部跳過,
            # 於是「有 Scenario」判定通過、六類全 N/A,一個零內容的 Requirement 就通關了。
            for entry in entries:
                if not isinstance(entry, dict):
                    f.error(where, f"Scenario 必須是 mapping,不能只寫 id: {entry!r}")

    for req, sc in scenarios(spec):
        sid = sc.get("id")
        where = f"{req.get('id')} / {sid or '(無 id)'}"
        if not sid or not SCENARIO_ID.match(str(sid)):
            f.error(where, "id 必須形如 SC-001 或 SC-001b")
        elif sid in seen_sc:
            f.error(where, "id 重複")
        else:
            seen_sc.add(sid)
        if not isinstance(sc.get("mode"), str) or sc.get("mode") not in MODES:
            f.error(where, f"mode 必須是 {'/'.join(sorted(MODES))} 其一,得到 {sc.get('mode')!r}")


def check_completeness(spec: dict, f: Findings) -> None:
    """六類遺漏逐項表態。指向的 Scenario 必須在**同一個** Requirement 裡 ——
    指到別的 Requirement 的 Scenario 等於這個 Requirement 自己零覆蓋。"""
    for req in spec.get("requirements") or []:
        if not isinstance(req, dict):
            continue
        rid = req.get("id")
        own = {sc.get("id") for sc in (req.get("scenarios") or []) if isinstance(sc, dict)}
        table = req.get("completeness")
        if not isinstance(table, dict):
            f.error(str(rid), "缺少 completeness 區塊(六類遺漏必須逐項表態)")
            continue
        for category in COMPLETENESS_CATEGORIES:
            where = f"{rid}.{category}"
            if category not in table:
                f.error(where, "未表態(要嘛列 Scenario,要嘛寫「N/A — 理由」)")
                continue
            value = table[category]
            if isinstance(value, list):
                if not value:
                    f.error(where, "空 list 等於沒表態")
                for sid in value:
                    if sid not in own:
                        f.error(where, f"{sid} 不在 {rid} 自己的 Scenario 裡")
            elif isinstance(value, str):
                text = value.strip()
                if not text.upper().startswith("N/A"):
                    f.error(where, "字串形式只接受「N/A — 理由」")
                elif len(re.sub(r"^N/?A\s*[—\-:：]?\s*", "", text, flags=re.I).strip()) < 8:
                    f.error(where, "N/A 必須附理由(且要說得出所以然,不是一個詞)")
            else:
                f.error(where, "必須是 Scenario id 的 list,或「N/A — 理由」字串")


def check_testability(spec: dict, f: Findings) -> None:
    for req, sc in scenarios(spec):
        sid = sc.get("id")
        where = f"{req.get('id')} / {sid}"
        mode = sc.get("mode")

        then = sc.get("then")
        if not isinstance(then, dict) or not then:
            f.error(where, "then 必須是非空的 mapping —— 散文沒有欄位可以放")

        # 豁免是一句可被挑戰的主張,不是一個 truthy 欄位。
        # 對抗審查實證:批准後偷加 `red_exempt_reason: x` 可以整條繞過 G5。
        exempt = sc.get("red_exempt_reason")
        if exempt is not None:
            text = str(exempt).strip()
            if len(text) < 12:
                f.error(where, "red_exempt_reason 太短 —— 豁免必須說得出所以然,"
                               "而且會被 reviewer 挑戰(有 stub 縫卻宣稱沒有就是鑽漏洞)")
            elif PLACEHOLDER.search(text):
                f.error(where, "red_exempt_reason 是佔位符")

        if mode == "6d":
            if not str(sc.get("manual_reason") or "").strip():
                f.error(where, "mode 6d 必須寫 manual_reason:為什麼這條不能自動化")
            continue  # 6d 沒有 examples

        examples = sc.get("examples")
        if not isinstance(examples, list) or not examples:
            f.error(where, "至少要有一組 examples(具體的 in → out);examples 就是契約")
            continue
        for index, example in enumerate(examples):
            spot = f"{where} examples[{index}]"
            if not isinstance(example, dict):
                f.error(spot, "每組 example 必須是 mapping")
                continue
            if "in" not in example:
                f.error(spot, "缺少 in")
            elif example.get("in") is None:
                f.error(spot, "in 是 null —— examples 就是契約,契約不能是空的")
            if "out" not in example:
                f.error(spot, "缺少 out")
            elif not isinstance(example.get("out"), (dict, list)) or not example.get("out"):
                f.error(spot, "out 必須是非空的具體結果(mapping 或 list)")


def check_vague(spec: dict, f: Findings) -> None:
    """最後一道網。只掃 then 與 examples.out —— 敘述性欄位(why/design/理由)不掃。"""
    for req, sc in scenarios(spec):
        where = f"{req.get('id')} / {sc.get('id')}"
        targets = [("then", sc.get("then"))]
        for index, example in enumerate(sc.get("examples") or []):
            if isinstance(example, dict):
                targets.append((f"examples[{index}].out", example.get("out")))
        for label, node in targets:
            for trail, text in walk_strings(node):
                spot = f"{where} {label}" + (f".{trail}" if trail else "")
                low = text.lower()
                # 整個字串等於黑名單詞,或黑名單詞當成一個「詞」出現(前後不是英數字)
                hit = next((w for w in VAGUE
                            if low == w.lower() or re.search(rf"(?<![a-z0-9]){re.escape(w.lower())}(?![a-z0-9])", low)),
                           None)
                if hit:
                    f.error(spot, f"空話「{hit}」—— 這裡只收具體的值")
                elif (limit := prose_limit(text)) is not None and len(text) > limit:
                    f.error(spot, f"葉值長達 {len(text)} 字,這是一句話不是一個值(上限 {limit})")

    for trail, text in walk_strings(spec):
        if PLACEHOLDER.search(text):
            f.error(trail or "(頂層)", f"殘留佔位符: {text.strip()[:48]}")


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__)
        return 2
    worst = 0
    for arg in argv:
        path = pathlib.Path(arg)
        if not path.exists():
            print(f"✘ 找不到 {path}")
            worst = 1
            continue
        print(f"▸ {path}")
        spec = load_spec(path)
        f = Findings()
        check_schema(spec, f)
        check_completeness(spec, f)
        check_testability(spec, f)
        check_vague(spec, f)
        worst = max(worst, f.report("spec-lint"))
    return worst


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
