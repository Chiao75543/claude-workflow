#!/usr/bin/env python3
"""traceability — G6:規格與測試雙向對得上。

  · 每條 Scenario 至少有一條測試看著
  · 每條測試引用的 SC-id 都解析得到(沒有孤兒測試)

測試檔位置與 SC-id 的認法來自 specs/pipeline.yaml(見 _config.py)。

用法: traceability <spec.yaml>
退出碼: 0 雙向齊全 / 1 有缺口
"""

from __future__ import annotations

import pathlib
import re
import sys

sys.path.insert(0, str(pathlib.Path(__file__).parent))
import _config  # noqa: E402
from _common import (  # noqa: E402
    MANUAL_MODES, RED_MODES, SMOKE_MODES, Findings, invalid_scenario_modes, load_spec,
    scenario_ids, scenario_ids_for_modes, spec_test_sources,
)


def collect_test_ids(config: dict, sources: list[dict]) -> dict[str, set[str]]:
    """回傳 {SC-id: {檔案相對路徑}}。"""
    pattern = re.compile(config["tests"]["scenario_pattern"])
    found: dict[str, set[str]] = {}
    for source in sources:
        text = source["text"]
        for match in pattern.finditer(text):
            found.setdefault(match.group(1), set()).add(source["rel"])
    return found


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print(__doc__)
        return 2
    spec_path = pathlib.Path(argv[0])
    root = spec_path.resolve().parents[2]
    spec = load_spec(spec_path)
    config = _config.load(root)
    f = Findings()

    declared = scenario_ids(spec)
    for sid, mode in invalid_scenario_modes(spec):
        f.error(sid, f"未知或缺少 mode {mode!r} —— 不能靜默略過追溯要求")

    expected = scenario_ids_for_modes(spec, RED_MODES)
    deferred_smoke = scenario_ids_for_modes(spec, SMOKE_MODES)
    manual = scenario_ids_for_modes(spec, MANUAL_MODES)
    test_sources, scope_source, scope_errors = spec_test_sources(root, spec_path.resolve(), config)
    for message in scope_errors:
        f.error("測試範圍", message)
    in_tests = collect_test_ids(config, test_sources)

    for sid in sorted(expected - set(in_tests)):
        f.error(sid, "規格有這條 Scenario,但沒有任何測試引用它")
    for sid in sorted(set(in_tests) - declared):
        f.error(sid, f"測試引用了規格裡不存在的 Scenario ({', '.join(sorted(in_tests[sid]))})")
    for sid in sorted(manual & set(in_tests)):
        f.warn(sid, "標記為只能人工驗(6d),卻有自動化測試引用 —— mode 可能該降級")
    for sid in sorted(deferred_smoke & set(in_tests)):
        f.warn(sid, "標記為 build/smoke 驗證(6c),另有自動化測試引用；S9b 仍須實跑,不能拿這條測試取代")

    print(f"  規格 {len(declared)} 條 Scenario(RED {len(expected)} · smoke {len(deferred_smoke)}"
          f" · 人工 {len(manual)}) · RED 測試涵蓋 {len(set(in_tests) & expected)} 條")
    print(f"  測試範圍 {len(test_sources)} 檔 · {scope_source}")
    return f.report("traceability")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
