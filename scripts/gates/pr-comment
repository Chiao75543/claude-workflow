#!/usr/bin/env python3
"""pr-comment — 把證據表變成 PR 留言。你看 PR 只看這一則。

從 evidence/dashboard.json 產 markdown。頂端只有兩種標題:
  「✅ 全乾淨,沒有要你決定的事」
  「⏸ 需要你決定」+ 條列(parked / flipflop 的 finding、等你回答的 edge case、
     只能人工驗的 Scenario、規格改了要重新批准)

用法: pr-comment <spec.yaml> [--check]
  --check  只回退出碼:0 全乾淨 / 1 有事要人決定(orchestrator 用它決定要不要標人)
"""

from __future__ import annotations

import json
import pathlib
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).parent))
import _config  # noqa: E402
from _common import evidence_dir, read_json  # noqa: E402
from _workflow_schemas import schema_for  # noqa: E402


def schema() -> dict:
    scalar = {"type": "string"}
    nullable = {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
    return {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object",
            "properties": {"status": {"type": "string", "enum": ["passed", "blocked", "rejected"]},
                           "reason": nullable, "title": scalar, "markdown": scalar,
                           "decisions": {"type": "array", "items": scalar},
                           "auto_push_ok": {"type": "boolean"},
                           "exit_code": {"type": "integer", "enum": [0, 1, 2]}},
            "required": ["status", "reason", "title", "markdown", "decisions", "auto_push_ok", "exit_code"],
            "additionalProperties": False}


def emit(payload: dict, code: int) -> int:
    payload["exit_code"] = code
    print(json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
    return code


def decisions(dash: dict) -> list[str]:
    """dashboard 已經把「要人做決定」的項目標好了(decision: true),這裡只負責排版。"""
    return [f"**{a['title']}** —— {a['body']}" for a in dash.get("attention") or [] if a.get("decision")]


def main(argv: list[str]) -> int:
    if argv == ["--help"]:
        print(__doc__)
        return 0
    if argv == ["--schema"]:
        print(json.dumps(schema_for("pr-comment"), ensure_ascii=False, sort_keys=True, separators=(",", ":")))
        return 0
    if len(argv) not in {1, 2} or argv[0].startswith("-") or (len(argv) == 2 and argv[1] != "--check"):
        return emit({"status": "rejected", "reason": "invalid_cli", "title": "", "markdown": "",
                     "decisions": [], "auto_push_ok": False}, 2)
    spec_path = pathlib.Path(argv[0]).resolve()
    root = spec_path.parents[2]
    ev = evidence_dir(spec_path)
    dash = read_json(ev / "dashboard.json")
    if dash is None:
        return emit({"status": "blocked", "reason": "missing_delivery_evidence", "title": "", "markdown": "",
                     "decisions": [], "auto_push_ok": False}, 1)
    findings = read_json(ev / "findings.json") or {}
    todo = decisions(dash)

    version, _, _ = _config.autonomy_version(_config.load(root))
    contract_ok = True
    if version == 1:
        required = [ev / name for name in ("autonomy.json", "status.json", "delivery.json")]
        contract_ok = all(path.is_file() and not path.is_symlink() for path in required)
        if contract_ok:
            for gate, args in (("autonomy", [str(spec_path), "check"]),
                               ("evidence-check", [str(spec_path), "--commit"])):
                proc = subprocess.run([str(root / "scripts/gates" / gate), *args], cwd=root,
                                      capture_output=True, text=True)
                if proc.returncode != 0:
                    contract_ok = False
                    break
        status = read_json(ev / "status.json") or {}
        contract_ok = (contract_ok and status.get("schema_version") == 1
                       and dash.get("auto_push_ok") is True
                       and all(row.get("ok") is True for row in dash.get("gates") or []))

    lines = []
    if todo:
        lines.append("## ⏸ 需要你決定")
        lines += [f"- {t}" for t in todo]
    else:
        lines.append("## ✅ 全乾淨,沒有要你決定的事")
    lines.append("")
    lines.append(f"**{dash.get('name')}** · `{dash.get('branch')}` · {dash.get('scale')}")
    lines.append("")
    lines.append("| 關卡 | | 結果 |")
    lines.append("|---|---|---|")
    for g in dash.get("gates") or []:
        lines.append(f"| {g['id']} | {g['what']} | {'✓' if g['ok'] else '✘'} {g['note']} |")
    s = (findings.get("summary") or {})
    if s:
        lines.append("")
        lines.append(f"審查活動量:提出 {s.get('proposed', 0)} → 作廢 {s.get('void', 0)} → 證實 {s.get('confirmed', 0)}")
    other = [a for a in dash.get("attention") or [] if not a.get("decision")]
    if other:
        lines.append("")
        lines.append("<details><summary>其他注意事項</summary>")
        lines.append("")
        lines += [f"- **{a['tag']}** {a['title']} —— {a['body']}" for a in other]
        lines.append("")
        lines.append("</details>")
    shots = dash.get("screenshots") or []
    if shots:
        lines.append("")
        lines.append("畫面證據:" + "、".join(shots))
    markdown = "\n".join(lines)
    clean = contract_ok and not todo
    if version == 1:
        return emit({"status": "passed" if clean else "blocked",
                     "reason": None if clean else "invalid_delivery_evidence",
                     "title": lines[0] if lines else "", "markdown": markdown,
                     "decisions": todo, "auto_push_ok": clean}, 0 if clean else 1)
    if "--check" in argv:
        return 1 if todo else 0
    print(markdown)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
